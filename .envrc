#!/usr/bin/env bash

_xv6_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
_xv6_manifest="${XV6_DEV_ENV_MANIFEST:-.xv6-dev-env-files}"
_xv6_envrc_local="$_xv6_root/.envrc.local"

if ! declare -F PATH_add >/dev/null 2>&1; then
  PATH_add() {
    case ":$PATH:" in
      *":$1:"*) ;;
      *) export PATH="$1${PATH:+:$PATH}" ;;
    esac
  }
fi

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  printf 'warning: bash .envrc runs in a child shell; use `source .envrc` or `direnv allow` to keep exports.\n' >&2
fi

_xv6_create_envrc_local() {
  [ ! -e "$_xv6_envrc_local" ] || return 0

  cat >"$_xv6_envrc_local" <<'EOF'
# Local xv6 dev-env overrides.
# Uncomment only the values you want to override. By default, this file does nothing.

# Branch/ref that provides the local dev-env files.
# export XV6_DEV_ENV_BRANCH=xv6-dev-env

# RISC-V toolchain prefix. Leave unset to auto-detect.
# export TOOLPREFIX=riscv64-linux-gnu-
# export XV6_TOOLPREFIX="$TOOLPREFIX"

# GDB executable. Leave unset to auto-detect.
# export XV6_GDB=gdb-multiarch

# QEMU executable.
# export XV6_QEMU=qemu-system-riscv64

# QEMU CPU count. Default is 1; use 2 or more when testing real concurrency.
# export XV6_CPUS=1

# GDB server endpoint used by QEMU and VS Code.
# export XV6_GDB_HOST=127.0.0.1
# export XV6_GDBPORT=25000

# Parallel build jobs. Leave unset to use all local cores.
# export XV6_JOBS=8

# User-program symbol loader script path.
# export XV6_USER_GDB_SCRIPT="$PWD/.direnv/xv6-user-gdb"

# compile_commands.json generation. Auto generation is enabled by default.
# export XV6_AUTO_COMPILE_COMMANDS=0
# export XV6_BEAR=bear
# export XV6_COMPILE_COMMANDS_TARGETS="kernel/kernel fs.img"
# export XV6_COMPILE_COMMANDS_CLEAN=1
EOF
}

_xv6_extend_envrc_local() {
  [ -f "$_xv6_envrc_local" ] || return 0
  grep -q 'XV6_AUTO_COMPILE_COMMANDS' "$_xv6_envrc_local" 2>/dev/null && return 0

  cat >>"$_xv6_envrc_local" <<'EOF'

# compile_commands.json generation. Auto generation is enabled by default.
# export XV6_AUTO_COMPILE_COMMANDS=0
# export XV6_BEAR=bear
# export XV6_COMPILE_COMMANDS_TARGETS="kernel/kernel fs.img"
# export XV6_COMPILE_COMMANDS_CLEAN=1
EOF
}

_xv6_create_envrc_local
_xv6_extend_envrc_local

if [ -f "$_xv6_envrc_local" ]; then
  # shellcheck disable=SC1091
  source "$_xv6_envrc_local"
fi

export XV6_REPO_ROOT="${XV6_REPO_ROOT:-$_xv6_root}"
export XV6_DEV_ENV_BRANCH="${XV6_DEV_ENV_BRANCH:-xv6-dev-env}"
export XV6_GDB_HOST="${XV6_GDB_HOST:-127.0.0.1}"
export XV6_GDBPORT="${XV6_GDBPORT:-25000}"
export XV6_CPUS="${XV6_CPUS:-1}"
export XV6_USER_GDB_SCRIPT="${XV6_USER_GDB_SCRIPT:-$_xv6_root/.direnv/xv6-user-gdb}"
export XV6_QEMU="${XV6_QEMU:-qemu-system-riscv64}"
export XV6_AUTO_COMPILE_COMMANDS="${XV6_AUTO_COMPILE_COMMANDS:-1}"
export XV6_COMPILE_COMMANDS_TARGETS="${XV6_COMPILE_COMMANDS_TARGETS:-kernel/kernel fs.img}"
export XV6_COMPILE_COMMANDS_CLEAN="${XV6_COMPILE_COMMANDS_CLEAN:-1}"
export XV6_COMPILE_COMMANDS_STAMP="${XV6_COMPILE_COMMANDS_STAMP:-$_xv6_root/.direnv/xv6-compile-commands.key}"

_xv6_first_command() {
  local candidate
  for candidate in "$@"; do
    if command -v "$candidate" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

_xv6_detect_toolprefix() {
  local prefix
  for prefix in riscv64-unknown-elf- riscv64-linux-gnu- riscv64-unknown-linux-gnu-; do
    if command -v "${prefix}gcc" >/dev/null 2>&1 &&
       command -v "${prefix}objdump" >/dev/null 2>&1; then
      printf '%s\n' "$prefix"
      return 0
    fi
  done
  return 1
}

export XV6_GDB="${XV6_GDB:-$(_xv6_first_command gdb-multiarch riscv64-unknown-elf-gdb riscv64-linux-gnu-gdb gdb 2>/dev/null || true)}"
export XV6_BEAR="${XV6_BEAR:-$(_xv6_first_command bear 2>/dev/null || true)}"
export TOOLPREFIX="${TOOLPREFIX:-$(_xv6_detect_toolprefix 2>/dev/null || true)}"
export XV6_TOOLPREFIX="${XV6_TOOLPREFIX:-$TOOLPREFIX}"

if [ -z "${MAKEFLAGS:-}" ]; then
  if [ -n "${XV6_JOBS:-}" ]; then
    export MAKEFLAGS="-j$XV6_JOBS"
  elif command -v nproc >/dev/null 2>&1; then
    export MAKEFLAGS="-j$(nproc)"
  elif command -v sysctl >/dev/null 2>&1; then
    export MAKEFLAGS="-j$(sysctl -n hw.ncpu)"
  fi
fi

PATH_add "$_xv6_root"

_xv6_sync_vscode_settings() {
  local settings="$_xv6_root/.vscode/settings.json"
  [ -f "$settings" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0

  XV6_VSCODE_SETTINGS="$settings" \
  XV6_VSCODE_GDB_HOST="$XV6_GDB_HOST" \
  XV6_VSCODE_GDBPORT="$XV6_GDBPORT" \
  XV6_VSCODE_CPUS="$XV6_CPUS" \
  python3 - <<'PY' 2>/dev/null || true
import json
import os
from pathlib import Path

path = Path(os.environ["XV6_VSCODE_SETTINGS"])
data = json.loads(path.read_text())
updates = {
    "xv6.gdbHost": os.environ["XV6_VSCODE_GDB_HOST"],
    "xv6.gdbPort": os.environ["XV6_VSCODE_GDBPORT"],
    "xv6.cpus": os.environ["XV6_VSCODE_CPUS"],
}
if any(data.get(key) != value for key, value in updates.items()):
    data.update(updates)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
PY
}

_xv6_bear_run() {
  local version major

  version="$($XV6_BEAR --version 2>/dev/null | awk '{print $2; exit}')"
  major="${version%%.*}"

  case "$major" in
    ''|0|1|2)
      "$XV6_BEAR" "$@"
      ;;
    *)
      "$XV6_BEAR" -- "$@"
      ;;
  esac
}

_xv6_compile_commands_key() {
  {
    printf 'toolprefix=%s\n' "$XV6_TOOLPREFIX"
    printf 'targets=%s\n' "$XV6_COMPILE_COMMANDS_TARGETS"
    printf 'clean=%s\n' "$XV6_COMPILE_COMMANDS_CLEAN"
    if [ -n "$XV6_BEAR" ]; then
      "$XV6_BEAR" --version 2>/dev/null || true
    fi
    git -C "$_xv6_root" ls-files -s -- Makefile conf/lab.mk 2>/dev/null || true
    git -C "$_xv6_root" diff -- Makefile conf/lab.mk 2>/dev/null || true
  } | git -C "$_xv6_root" hash-object --stdin 2>/dev/null
}

_xv6_refresh_compile_commands() {
  local mode="${1:-auto}"
  local key old_key

  if [ "$mode" != "force" ] && [ "${XV6_SKIP_AUTO_COMPILE_COMMANDS:-0}" = "1" ]; then
    return 0
  fi

  if [ "$mode" != "force" ] && [ "$XV6_AUTO_COMPILE_COMMANDS" = "0" ]; then
    return 0
  fi

  if [ -z "$XV6_BEAR" ]; then
    if [ "$mode" = "force" ] || [ ! -s "$_xv6_root/compile_commands.json" ]; then
      printf 'xv6 dev-env: bear is not installed; compile_commands.json was not generated.\n' >&2
    fi
    [ "$mode" = "force" ] && return 1
    return 0
  fi

  if [ -z "$XV6_TOOLPREFIX" ]; then
    [ "$mode" = "force" ] && printf 'xv6 dev-env: RISC-V toolchain missing; cannot generate compile_commands.json.\n' >&2
    [ "$mode" = "force" ] && return 1
    return 0
  fi

  mkdir -p "$_xv6_root/.direnv"
  key="$(_xv6_compile_commands_key)"
  old_key="$(cat "$XV6_COMPILE_COMMANDS_STAMP" 2>/dev/null || true)"

  if [ "$mode" != "force" ] && [ -s "$_xv6_root/compile_commands.json" ] && [ "$key" = "$old_key" ]; then
    return 0
  fi

  printf 'xv6 dev-env: generating compile_commands.json with bear...\n'
  if ! (
    cd "$_xv6_root" || exit 1
    rm -f compile_commands.json
    if [ "$XV6_COMPILE_COMMANDS_CLEAN" != "0" ]; then
      make clean
    fi
    # shellcheck disable=SC2086
    _xv6_bear_run make $XV6_COMPILE_COMMANDS_TARGETS
  ); then
    printf 'xv6 dev-env: failed to generate compile_commands.json.\n' >&2
    [ "$mode" = "force" ] && return 1
    return 0
  fi

  if [ -s "$_xv6_root/compile_commands.json" ]; then
    printf '%s\n' "$key" >"$XV6_COMPILE_COMMANDS_STAMP"
  else
    printf 'xv6 dev-env: bear finished but compile_commands.json is empty or missing.\n' >&2
    [ "$mode" = "force" ] && return 1
  fi
}

_xv6_sync_vscode_settings

if declare -F watch_file >/dev/null 2>&1; then
  watch_file "$_xv6_envrc_local"
  watch_file "$_xv6_root/$_xv6_manifest"
  watch_file "$_xv6_root/Makefile"
  watch_file "$_xv6_root/conf/lab.mk"
  watch_file "$_xv6_root/.git/refs/heads/$XV6_DEV_ENV_BRANCH"
  watch_file "$_xv6_root/.git/refs/remotes/origin/$XV6_DEV_ENV_BRANCH"
  watch_file "$_xv6_root/.git/packed-refs"
fi

_xv6_resolve_dev_env_ref() {
  local candidate

  if [ "${XV6_DEV_ENV_BRANCH#*/}" != "$XV6_DEV_ENV_BRANCH" ]; then
    git -C "$_xv6_root" rev-parse --verify -q "$XV6_DEV_ENV_BRANCH^{commit}" 2>/dev/null
    return $?
  fi

  for candidate in "$XV6_DEV_ENV_BRANCH" "origin/$XV6_DEV_ENV_BRANCH"; do
    if git -C "$_xv6_root" rev-parse --verify -q "$candidate^{commit}" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

_xv6_manifest_paths() {
  git -C "$_xv6_root" show "$1:$_xv6_manifest" 2>/dev/null |
    sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d'
}

_xv6_update_info_exclude() {
  local paths="$1"
  local exclude="$_xv6_root/.git/info/exclude"
  local marker="# xv6 dev-env local files"
  local path

  [ -f "$exclude" ] || return 0
  if ! grep -qxF "$marker" "$exclude" 2>/dev/null; then
    printf '\n%s\n' "$marker" >>"$exclude" 2>/dev/null || return 0
  fi

  {
    printf '%s\n' "$paths"
    printf '%s\n' ".envrc.local" ".direnv/" "compile_commands.json" ".cache/"
  } | while IFS= read -r path; do
    [ -n "$path" ] || continue
    grep -qxF "$path" "$exclude" 2>/dev/null || printf '%s\n' "$path" >>"$exclude" 2>/dev/null || true
  done
}

_xv6_sync_dev_env() {
  local ref paths marker current old_envrc_hash new_envrc_hash

  ref="$(_xv6_resolve_dev_env_ref || true)"
  [ -n "$ref" ] || return 0

  paths="$(_xv6_manifest_paths "$ref")"
  [ -n "$paths" ] || return 0

  mkdir -p "$_xv6_root/.direnv"
  _xv6_update_info_exclude "$paths"

  marker="$_xv6_root/.direnv/xv6-dev-env.ref"
  current="$(cat "$marker" 2>/dev/null || true)"
  [ "$current" != "$ref" ] || return 0

  old_envrc_hash="$(git -C "$_xv6_root" hash-object "$_xv6_root/.envrc" 2>/dev/null || true)"
  # The manifest intentionally contains only local development files. Extracting
  # them from the orphan branch does not touch the current branch index.
  # shellcheck disable=SC2086
  git -C "$_xv6_root" archive --format=tar "$ref" $paths | tar -x -C "$_xv6_root"
  printf '%s\n' "$ref" >"$marker"

  new_envrc_hash="$(git -C "$_xv6_root" hash-object "$_xv6_root/.envrc" 2>/dev/null || true)"
  printf 'xv6 dev-env synced from %s@%s\n' "$XV6_DEV_ENV_BRANCH" "$(printf '%s' "$ref" | cut -c1-12)"
  if [ -n "$old_envrc_hash" ] && [ "$old_envrc_hash" != "$new_envrc_hash" ]; then
    printf 'xv6 dev-env updated .envrc; run `direnv allow` if direnv blocks reload.\n'
  fi
}

_xv6_sync_dev_env
_xv6_refresh_compile_commands auto

_xv6_missing=""
command -v make >/dev/null 2>&1 || _xv6_missing="$_xv6_missing make"
command -v "$XV6_QEMU" >/dev/null 2>&1 || _xv6_missing="$_xv6_missing $XV6_QEMU"
[ -n "$XV6_GDB" ] || _xv6_missing="$_xv6_missing gdb"
[ -n "$XV6_TOOLPREFIX" ] || _xv6_missing="$_xv6_missing riscv64-toolchain"
if [ "$XV6_AUTO_COMPILE_COMMANDS" != "0" ] && [ -z "$XV6_BEAR" ]; then
  _xv6_missing="$_xv6_missing bear"
fi

if [ -n "$_xv6_missing" ]; then
  printf 'xv6 dev env missing:%s\n' "$_xv6_missing"
fi
