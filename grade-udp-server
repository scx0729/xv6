#!/usr/bin/env python3

import subprocess

from gradelib import *


r = Runner(save("xv6.out.udp-server"))


@test(1, "UDP server")
def test_udp_server():
    client = subprocess.Popen(
        ["make", "udp-server-client"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    try:
        r.run_qemu(shell_script(["udpservertest"]), timeout=20)
        stdout, stderr = client.communicate(timeout=15)
    finally:
        if client.poll() is None:
            client.terminate()
            client.communicate()

    if client.returncode != 0:
        raise AssertionError("host UDP client failed:\n%s" % stderr.strip())
    if "UDP SERVER CLIENT PASSED" not in stdout:
        raise AssertionError("host UDP client did not complete")
    r.match("^UDP SERVER TEST PASSED$")


run_tests()
